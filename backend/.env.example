# -------------------------
# Ruhab Studio - FastAPI API
# -------------------------

# App
APP_NAME=ruhab-studio-api
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
JWT_SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ruhab_studio

# Collections
COLLECTION_PRODUCTS=products
COLLECTION_USERS=users
COLLECTION_ORDERS=orders
COLLECTION_ADMINS=admins
COLLECTION_PRODUCT_REVIEWS=product_reviews
COLLECTION_SHIPPING_ADDRESSES=shipping_addresses

# Admin bootstrap (use only for initial seed)
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@ruhabstudio.com
INITIAL_ADMIN_PASSWORD=change-this-password

# Media storage (choose one provider when implementing uploads)
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative single-variable format
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email / notifications (optional for admin alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ruhabstudio.com
