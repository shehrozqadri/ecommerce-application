# -------------------------
# Ruhab Studio - Next.js Web
# -------------------------

# Public app settings
NEXT_PUBLIC_APP_NAME=Ruhab Studio
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Auth/session UI defaults
NEXT_PUBLIC_ACCESS_TOKEN_STORAGE_KEY=ruhab_access_token
NEXT_PUBLIC_REFRESH_TOKEN_STORAGE_KEY=ruhab_refresh_token

# Optional: analytics / feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
